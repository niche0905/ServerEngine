<root BTCPP_format="4" main_tree_to_execute="Cat_MainTree">
    <BehaviorTree ID="Cat_MainTree">
        <ReactiveFallback>

            <!-- 전투 -->
            <Sequence>
                <CatAcquireOrValidateTarget
                        self_npc="{self_npc}"
                        target_id="{target_id}"
                        target_pawn="{target_pawn}"
                        combat_mode="{combat_mode}" />

                <CatDecideCombatMode
                        self_npc="{self_npc}"
                        target_pawn="{target_pawn}"
                        combat_mode="{combat_mode}" />

                <Fallback>

                    <!-- 원거리 모드 -->
                    <Sequence>
                        <CatIsCombatModeCannon
                                combat_mode="{combat_mode}" />

                        <Fallback>
                            <Sequence>
                                <CatIsTargetInCannonRange
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}" />

                                <CatMouthCannonCombat
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}"
                                        combat_mode="{combat_mode}" />
                            </Sequence>

                            <CatMoveToCannonRange
                                    self_npc="{self_npc}"
                                    target_pawn="{target_pawn}" />
                        </Fallback>
                    </Sequence>

                    <!-- 근거리 모드 -->
                    <Sequence>
                        <CatIsCombatModeMelee
                                combat_mode="{combat_mode}" />

                        <Fallback>
                            <Sequence>
                                <CatIsTargetInMeleeRange
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}" />

                                <CatDecideMeleeAttackType
                                        self_npc="{self_npc}"
                                        combat_mode="{combat_mode}" />

                                <Fallback>
                                    <Sequence>
                                        <CatIsMeleeAttackClaw combat_mode="{combat_mode}" />
                                        <CatFrontClawAttack
                                                self_npc="{self_npc}"
                                                target_pawn="{target_pawn}"
                                                combat_mode="{combat_mode}" />
                                    </Sequence>

                                    <Sequence>
                                        <CatIsMeleeAttackBite combat_mode="{combat_mode}" />
                                        <CatBiteAttack
                                                self_npc="{self_npc}"
                                                target_pawn="{target_pawn}"
                                                combat_mode="{combat_mode}" />
                                    </Sequence>
                                </Fallback>
                            </Sequence>

                            <CatMoveTarget
                                    self_npc="{self_npc}"
                                    target_id="{target_id}"
                                    target_pawn="{target_pawn}" />
                        </Fallback>
                    </Sequence>

                </Fallback>
            </Sequence>

            <!-- 비전투 -->
            <Sequence>
                <CatPatrolAroundSpawn
                        self_npc="{self_npc}" />

                <CatIdle
                        self_npc="{self_npc}" />
            </Sequence>

        </ReactiveFallback>
    </BehaviorTree>
</root>
