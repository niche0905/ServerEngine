<root BTCPP_format="4" main_tree_to_execute="Cat_MainTree">
    <BehaviorTree ID="Cat_MainTree">
        <Fallback>

            <!-- 전투 -->
            <Sequence>
                <AcquireOrValidateTarget
                        self_npc="{self_npc}"
                        target_id="{target_id}"
                        target_pawn="{target_pawn}" />

                <DecideCombatMode
                        self_npc="{self_npc}"
                        target_pawn="{target_pawn}" />

                <Fallback>

                    <!-- 원거리 모드 -->
                    <Sequence>
                        <IsCombatModeCannon
                                self_npc="{self_npc}" />

                        <Fallback>
                            <Sequence>
                                <IsTargetInCannonRange
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}" />

                                <MouthCannonCombat
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}" />
                            </Sequence>

                            <MoveToCannonRange
                                    self_npc="{self_npc}"
                                    target_pawn="{target_pawn}" />
                        </Fallback>
                    </Sequence>

                    <!-- 근거리 모드 -->
                    <Sequence>
                        <IsCombatModeMelee
                                self_npc="{self_npc}" />

                        <Fallback>
                            <Sequence>
                                <IsTargetInMeleeRange
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}" />
                                
                                <DecideMeleeAttackType 
                                        self_npc="{self_npc}" />

                                <Fallback>
                                    <Sequence>
                                        <IsMeleeAttackClaw self_npc="{self_npc}" />
                                        <FrontClawAttack self_npc="{self_npc}" target_pawn="{target_pawn}" />
                                    </Sequence>

                                    <Sequence>
                                        <IsMeleeAttackBite self_npc="{self_npc}" />
                                        <BiteAttack self_npc="{self_npc}" target_pawn="{target_pawn}" />
                                    </Sequence>
                                </Fallback>
                            </Sequence>

                            <MoveTarget
                                    self_npc="{self_npc}"
                                    target_pawn="{target_pawn}" />
                        </Fallback>
                    </Sequence>

                </Fallback>
            </Sequence>

            <!-- 비전투 -->
            <Fallback>
                <PatrolAroundSpawn
                        self_npc="{self_npc}" />

                <Idle
                        self_npc="{self_npc}" />
            </Fallback>

        </Fallback>
    </BehaviorTree>
</root>
