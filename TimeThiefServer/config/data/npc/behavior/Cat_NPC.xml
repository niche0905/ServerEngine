<root BTCPP_format="4" main_tree_to_execute="Cat_MainTree">
    <BehaviorTree ID="Cat_MainTree">
        <ReactiveFallback>

            <!-- 전투 -->
            <Sequence>
                <AcquireOrValidateTarget
                        self_npc="{self_npc}"
                        target_id="{target_id}"
                        target_pawn="{target_pawn}"
                        combat_mode="{combat_mode}" />

                <DecideCombatMode
                        self_npc="{self_npc}"
                        target_pawn="{target_pawn}"
                        combat_mode="{combat_mode}" />

                <Fallback>

                    <!-- 원거리 모드 -->
                    <Sequence>
                        <IsCombatModeCannon
                                combat_mode="{combat_mode}" />

                        <Fallback>
                            <Sequence>
                                <IsTargetInCannonRange
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}" />

                                <MouthCannonCombat
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}"
                                        combat_mode="{combat_mode}" />
                            </Sequence>

                            <MoveToCannonRange
                                    self_npc="{self_npc}"
                                    target_pawn="{target_pawn}" />
                        </Fallback>
                    </Sequence>

                    <!-- 근거리 모드 -->
                    <Sequence>
                        <IsCombatModeMelee
                                combat_mode="{combat_mode}" />

                        <Fallback>
                            <Sequence>
                                <IsTargetInMeleeRange
                                        self_npc="{self_npc}"
                                        target_pawn="{target_pawn}" />
                                
                                <DecideMeleeAttackType 
                                        self_npc="{self_npc}"
                                        combat_mode="{combat_mode}" />

                                <Fallback>
                                    <Sequence>
                                        <IsMeleeAttackClaw combat_mode="{combat_mode}" />
                                        <FrontClawAttack
                                                self_npc="{self_npc}"
                                                target_pawn="{target_pawn}"
                                                combat_mode="{combat_mode}" />
                                    </Sequence>

                                    <Sequence>
                                        <IsMeleeAttackBite combat_mode="{combat_mode}" />
                                        <BiteAttack
                                                self_npc="{self_npc}"
                                                target_pawn="{target_pawn}"
                                                combat_mode="{combat_mode}" />
                                    </Sequence>
                                </Fallback>
                            </Sequence>

                            <MoveTarget
                                    self_npc="{self_npc}"
                                    target_pawn="{target_pawn}" />
                        </Fallback>
                    </Sequence>

                </Fallback>
            </Sequence>

            <!-- 비전투 -->
            <Sequence>
                <PatrolAroundSpawn
                        self_npc="{self_npc}" />

                <Idle
                        self_npc="{self_npc}" />
            </Sequence>

        </ReactiveFallback>
    </BehaviorTree>
</root>
